# TerraForge Campus Sensor Monitoring and Alerts Configuration

# Application settings
APP_NAME=TerraForge
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://terraforge:terraforge@localhost:5432/terraforge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Ingestion queue and background worker settings
READING_QUEUE_NAME=terraforge:readings
BATCH_MAX_SIZE=1000
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=1000

# Alerting & Deduplication
ALERT_DEDUPLICATION_SECONDS=300
DEFAULT_WINDOW_SECONDS=600
